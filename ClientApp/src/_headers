# Cloudflare static-asset headers (Workers static assets and Pages both read this file from the root of the uploaded
# directory; it is copied there by angular.json "assets"). Docs: salsa/docs/ui/pwa.md.
#
# The service worker, its manifest (ngsw.json), the page and the web app manifest must always be revalidated, or a
# device can keep running an old version long after a deploy. Everything Angular emits with a content hash is safe to
# cache forever; the root *.js / *.css bundles can't be matched separately here (no suffix patterns), so they keep
# Cloudflare's default "max-age=0, must-revalidate" + ETag (the service worker serves them from its own cache anyway).
#
# Don't list a path under two rules that both set Cache-Control: Cloudflare joins the values with a comma.

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/ngsw.json
  Cache-Control: no-cache

/ngsw-worker.js
  Cache-Control: no-cache

/safety-worker.js
  Cache-Control: no-cache

/worker-basic.min.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

/media/*
  Cache-Control: public, max-age=31536000, immutable
