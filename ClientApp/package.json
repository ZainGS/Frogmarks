{
  "name": "frogmarks",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "ng": "ng",
    "prestart": "node aspnetcore-https.cjs",
    "start": "run-script-os",
    "start:windows": "ng serve --port 44452 --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\"",
    "start:default": "ng serve --port 44452 --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\"",
    "start:fresh": "run-script-os",
    "start:fresh:windows": "rmdir /s /q .angular\\cache 2>nul & ng serve --port 44452 --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\"",
    "start:fresh:default": "rm -rf .angular/cache && ng serve --port 44452 --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\"",
    "prebuild": "node scripts/check-shapemanager-types.mjs",
    "check:sm-types": "node scripts/check-shapemanager-types.mjs",
    "check:templates": "node scripts/check-template-members.mjs",
    "check:di-cycles": "node scripts/check-service-cycles.mjs",
    "check": "node scripts/check.mjs",
    "check:fast": "node scripts/check.mjs --fast",
    "lint": "eslint . --pass-on-unpruned-suppressions",
    "sanity": "node scripts/check-source-sanity.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "postinstall": "echo postinstall ok"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/material": "^17.3.10",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "@zaings/salsa": "file:../../../salsa",
    "bootstrap": "^5.3.3",
    "gifenc": "^1.0.3",
    "jszip": "^3.10.1",
    "mp4-muxer": "^5.2.2",
    "rxjs": "~7.5.6",
    "tslib": "^2.4.0",
    "zone.js": "~0.14.8"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.8",
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/cli": "^17.3.8",
    "@angular/compiler-cli": "^17.3.12",
    "@eslint/js": "^9.39.5",
    "@types/jasmine": "~4.3.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20.14.12",
    "@webgpu/types": "^0.1.54",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.1",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "node": "18.19",
    "run-script-os": "^1.1.6",
    "sharp": "^0.35.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "autoprefixer": "10.4.5"
  }
}
